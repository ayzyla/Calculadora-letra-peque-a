}
pintarAnios4c();

function calcularFull(){
  var S0 = val('salario');

  var Sprev = S0;
  var perdidaTotalAcumulada = 0;
  var rowsHtml = '';

  ANIOS.forEach(function(a){
    var ipc = val('ipc_' + a);
    var rsi = val('rsi_' + a);
    var promo = val('promo_' + a);
    var recA = val('rec_' + a);
    var abril = document.getElementById('abril_' + a).checked;
    var varPct = val('varPct_' + a) / 100;
    var consec = val('consec_' + a) / 100;

    var subidaAnunciada = ipc + rsi + promo + recA;
    var Snew = Sprev * (1 + subidaAnunciada / 100);

    var fijoRef = Snew;
    // 14 pagas (12 ordinarias + 2 extras de una mensualidad completa). Las extras se pagan ya al salario nuevo
    // desde enero (según la empresa), así que solo las 12 ordinarias sufren el retraso hasta abril:
    // 3 meses al salario anterior + 9 meses al nuevo + las 2 extras al nuevo, todo entre 14.
    var fijoReal = abril ? ((Sprev * 3 + Snew * 11) / 14) : Snew;

    var varRef = varPct * Sprev;
    var varReal = varPct * Sprev * consec;

    var totalRef = fijoRef + varRef;
    var totalReal = fijoReal + varReal;

    var perdidaAbril = fijoRef - fijoReal;
    var perdidaVariable = varRef - varReal;
    var perdidaTotal = totalRef - totalReal;
    perdidaTotalAcumulada += perdidaTotal;

    rowsHtml += '<div class="resultyear">' +
      '<div class="yh">' + a + '</div>' +
      '<div class="compare">' +
        '<div class="box"><div class="k">SUBIDA SALARIAL</div><div class="v pos">' + fmtPct(subidaAnunciada, true) + '</div></div>' +
      '</div>' +
      '<table class="breaktable">' +
        '<thead><tr><th></th><th>Salario que te correspondería</th><th>Salario percibido</th></tr></thead>' +
        '<tbody>' +
          '<tr><td>Fijo</td><td class="correspond">' + fmtEUR(fijoRef) + '</td><td class="real">' + fmtEUR(fijoReal) + '</td></tr>' +
          '<tr><td>Variable</td><td class="correspond">' + fmtEUR(varRef) + '</td><td class="real">' + fmtEUR(varReal) + '</td></tr>' +
          '<tr class="totalrow"><td>Total</td><td class="correspond">' + fmtEUR(totalRef) + '</td><td class="real">' + fmtEUR(totalReal) + '</td></tr>' +
        '</tbody>' +
      '</table>' +
      '<div class="lossrow"><div class="k">Efecto abril</div><div class="v">\u2212' + fmtEUR(Math.abs(perdidaAbril)) + '</div></div>' +
      '<div class="lossrow" style="border-bottom:none;"><div class="k">Reducci\u00f3n del variable</div><div class="v">\u2212' + fmtEUR(Math.abs(perdidaVariable)) + '</div></div>' +
      '<div class="lineitem" style="margin-top:10px;"><div class="k">P\u00e9rdida total ' + a + '</div><div class="v" style="color:var(--red);">\u2212' + fmtEUR(Math.abs(perdidaTotal)) + '</div></div>' +
    '</div>';

    Sprev = Snew;
  });

  rowsHtml += '<div class="totalbox" style="margin-top:18px;"><div class="k">P\u00c9RDIDA ECON\u00d3MICA TOTAL POR EFECTO ABRIL E HIPOT\u00c9TICA REDUCCI\u00d3N DE VARIABLE 2026\u20132029</div><div class="v">\u2212' + fmtEUR(Math.abs(perdidaTotalAcumulada)) + '</div></div>';

  window.RESUMEN_PERDIDAS.abrilVariable = perdidaTotalAcumulada;
  pintarResumen();

  var cont = document.getElementById('resultsFull');
  cont.innerHTML = rowsHtml;
  cont.classList.add('show');
}
document.getElementById('calcBtnFull').addEventListener('click', calcularFull);

function calcularDiferir(){
  const S0 = val('salario');
  const ipcs = ANIOS.map(a => val('ipc_' + a));
  const rsis = ANIOS.map(a => val('rsi_' + a));
  const promos = ANIOS.map(a => val('promo_' + a));
  const recs = ANIOS.map(a => val('rec_' + a));
  const varPcts = ANIOS.map(a => val('varPct_' + a) / 100);
  const recTotal = recs.reduce((s, r) => s + r, 0);

  // Siempre efecto desde enero y consecución de objetivos al 100% en esta comparación.
  // El variable de cada año se calcula sobre el salario del año anterior (misma regla que la calculadora principal).

  // Escenario A: toda la recuperación salarial de golpe en 2026 (junto con el IPC, RSI y promoción de cada año),
  // en vez de repartida en los tramos introducidos.
  let a = [];
  let sFijo = S0;
  for (let i = 0; i < ANIOS.length; i++) {
    const recEsteAnio = (i === 0) ? recTotal : 0;
    const subida = ipcs[i] + rsis[i] + promos[i] + recEsteAnio;
    const fijoAnterior = sFijo;
    sFijo = sFijo * (1 + subida / 100);
    const variable = varPcts[i] * fijoAnterior;
    a.push({ fijo: sFijo, variable: variable, total: sFijo + variable });
  }
  const acumInmediato = a.reduce((s, y) => s + y.total, 0);

  // Escenario B: repartida en los tramos de recuperación introducidos en cada año, con el resto de datos igual.
  let b = [];
  sFijo = S0;
  for (let i = 0; i < ANIOS.length; i++) {
    const subida = ipcs[i] + rsis[i] + promos[i] + recs[i];
    const fijoAnterior = sFijo;
    sFijo = sFijo * (1 + subida / 100);
    const variable = varPcts[i] * fijoAnterior;
    b.push({ fijo: sFijo, variable: variable, total: sFijo + variable });
  }
  const acumRepartido = b.reduce((s, y) => s + y.total, 0);

  const perdida = acumInmediato - acumRepartido;

  document.getElementById('acumInmediato').textContent = fmtEUR(acumInmediato);
  document.getElementById('acumRepartido').textContent = fmtEUR(acumRepartido);
  document.getElementById('perdida4y').textContent = '\u2212' + fmtEUR(Math.abs(perdida));

  document.getElementById('resultsDiferir').classList.add('show');

  window.RESUMEN_PERDIDAS.diferir = perdida;
  pintarResumen();
}
document.getElementById('calcBtnDiferir').addEventListener('click', calcularDiferir);

var HIST = [
  { anio: 2020, rsg: 1.0,  ipc: -0.5 },
  { anio: 2021, rsg: 1.0,  ipc: 6.5 },
  { anio: 2022, rsg: 1.5,  ipc: 5.7 },
  { anio: 2023, rsg: 1.5,  ipc: 3.1 },
  { anio: 2024, rsg: 3.0,  ipc: 2.8 },
  { anio: 2025, rsg: 2.0,  ipc: 2.9 }
];

function pintarTablaHist(){
  var tbody = document.getElementById('tablaHist');
  tbody.innerHTML = HIST.map(function(h){
    return '<tr style="border-bottom:1px solid var(--line);">' +
      '<td style="padding:6px 4px;">' + h.anio + '</td>' +
      '<td style="text-align:right;padding:6px 4px;">' + (h.rsg > 0 ? '+' : '') + h.rsg.toLocaleString('es-ES',{minimumFractionDigits:1}) + ' %</td>' +
      '<td style="text-align:right;padding:6px 4px;">' + (h.ipc > 0 ? '+' : '') + h.ipc.toLocaleString('es-ES',{minimumFractionDigits:1}) + ' %</td>' +
    '</tr>';
  }).join('');
}
pintarTablaHist();

function factoresHist(){
  var rsgFactor = 1;
  var ipcFactor = 1;
  HIST.forEach(function(h){
    rsgFactor *= (1 + h.rsg / 100);
    ipcFactor *= (1 + h.ipc / 100);
  });
  return { rsgFactor: rsgFactor, ipcFactor: ipcFactor };
}

function calcularPerdidaHist(){
  var S0 = val('salario');
  var f = factoresHist();
  var salarioBase = S0 / f.rsgFactor;

  var salarioReal = salarioBase;
  var salarioIpc = salarioBase;
  var perdidaAcumulada = 0;
  HIST.forEach(function(h){
    salarioReal *= (1 + h.rsg / 100);
    salarioIpc *= (1 + h.ipc / 100);
    perdidaAcumulada += (salarioIpc - salarioReal);
  });

  document.getElementById('perdidaHist').textContent = '\u2212' + fmtEUR(Math.abs(perdidaAcumulada));
  document.getElementById('resultsPerdidaHist').classList.add('show');

  window.RESUMEN_PERDIDAS.hist2020 = perdidaAcumulada;
  pintarResumen();
}
document.getElementById('calcBtnPerdidaHist').addEventListener('click', calcularPerdidaHist);

function calcularHist(){
  var S0 = val('salario');
  var reconocido = val('reconocido');
  var f = factoresHist();

  var recuperacionRealPct = (f.ipcFactor / f.rsgFactor - 1) * 100;
  var diffPct = recuperacionRealPct - reconocido;

  // Proyección 2026-2029: se usa el salario que realmente resulta de los datos introducidos en el escenario
  // (IPC, subida individual, promoción y recuperación de cada año, tal como en "Calculadora completa 2026-2029"),
  // y sobre ese salario cada año se aplica el % que sigue sin reconocerse (diffPct).
  var sFuturo = S0;
  var perdidaFutura = 0;
  ANIOS.forEach(function(a){
    var subidaAnio = val('ipc_' + a) + val('rsi_' + a) + val('promo_' + a) + val('rec_' + a);
    sFuturo = sFuturo * (1 + subidaAnio / 100);
    perdidaFutura += sFuturo * (diffPct / 100);
  });

  document.getElementById('recuperacionReal').textContent = fmtPct(recuperacionRealPct, true);
  document.getElementById('diffReconocido').textContent = fmtPct(diffPct, true) + ' respecto a lo reconocido';
  document.getElementById('perdidaNoReconocido2029').textContent = '\u2212' + fmtEUR(Math.abs(perdidaFutura));

  document.getElementById('resultsHist').classList.add('show');

  window.RESUMEN_PERDIDAS.noReconocido2029 = perdidaFutura;
  pintarResumen();
}
document.getElementById('calcBtnHist').addEventListener('click', calcularHist);
