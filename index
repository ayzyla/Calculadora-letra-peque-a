      '</div>' +
      '<div class="subhead">Variable de ' + a + '</div>' +
      '<div class="field"><label class="label" for="varPct_' + a + '">Variable objetivo (%)</label>' +
      '<input type="text" inputmode="decimal" id="varPct_' + a + '" value="10"></div>' +
      '<div class="hint" style="margin-bottom:6px;">Selecciona consecuci\u00f3n de objetivos posibles por el nuevo c\u00e1lculo de la PG-255</div>' +
      '<div class="pillrow" id="pillrow_' + a + '">' +
        CONSEC_PILLS.map(function(p){ return '<button type="button" class="pillbtn" data-anio="' + a + '" data-v="' + p + '">' + p + ' %</button>'; }).join('') +
      '</div>' +
      '<div class="field"><label class="label" for="consec_' + a + '">Consecuci\u00f3n de objetivos (%)</label>' +
      '<input type="text" inputmode="decimal" id="consec_' + a + '" value="100" readonly></div>' +
    '</div>';
  });
  cont.innerHTML = html;

  cont.querySelectorAll('.pillbtn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var a = btn.dataset.anio;
      document.querySelectorAll('#pillrow_' + a + ' .pillbtn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('consec_' + a).value = btn.dataset.v;
