<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Calculadora de la letra pequeña</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f7f7f8;
    --card:#ffffff;
    --ink:#111114;
    --sub:#6b6d73;
    --line:#e2e2e6;
    --green:#1c8a4b;
    --red:#c62f2f;
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    -webkit-text-size-adjust:100%;
  }
  .wrap{ max-width:600px; margin:0 auto; padding:22px 18px 60px; }

  h1{
    font-size:26px;
    font-weight:800;
    letter-spacing:-0.01em;
    margin:0 0 20px;
  }
  h1.sub{ font-size:21px; margin:0 0 6px; }

  .label{
    font-size:14.5px;
    font-weight:600;
    color:var(--ink);
    margin:0 0 8px;
    display:block;
  }
  .hint{
    font-size:12.5px;
    color:var(--sub);
    margin:6px 2px 18px;
  }
  .row2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
  }
  .field{ margin-bottom:16px; }

  input[type=text]{
    width:100%;
    font-family:'Inter',sans-serif;
    font-size:17px;
    font-weight:500;
    color:var(--ink);
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:999px;
    padding:14px 18px;
  }
  input:focus{ outline:none; border-color:var(--ink); }
  input[readonly]{ background:var(--bg); color:var(--sub); }

  .pillrow{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:2px 0 4px;
  }
  .pillbtn{
    font-family:'Inter',sans-serif;
    font-size:13.5px;
    font-weight:600;
    padding:8px 14px;
    border-radius:999px;
    border:1.5px solid var(--line);
    background:var(--card);
    color:var(--ink);
    cursor:pointer;
  }
  .pillbtn.active{
    background:var(--ink);
    color:#fff;
    border-color:var(--ink);
  }

  .calcbtn{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    background:var(--ink);
    color:#fff;
    font-family:'Inter',sans-serif;
    font-size:17px;
    font-weight:700;
    border:none;
    border-radius:999px;
    padding:16px;
    margin:6px 0 26px;
    cursor:pointer;
  }
  .calcbtn svg{ width:20px; height:20px; }

  hr.sep{ border:none; border-top:1px solid var(--line); margin:28px 0 22px; }

  .results{ display:none; }
  .results.show{ display:block; }

  .compare{
    display:grid;
    grid-template-columns:1fr;
    gap:14px;
    margin-bottom:16px;
  }
  .compare .box{
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:18px;
    padding:16px 14px;
  }
  .compare .k{
    font-size:12px;
    font-weight:700;
    letter-spacing:.04em;
    color:var(--sub);
    margin-bottom:6px;
  }
  .compare .v{
    font-size:26px;
    font-weight:800;
    line-height:1.1;
  }
  .compare .v.pos{ color:var(--green); }
  .compare .v.neg{ color:var(--red); }

  .lineitem{ margin-bottom:18px; }
  .lineitem .k{ font-size:14.5px; color:var(--sub); margin-bottom:4px; }
  .lineitem .v{ font-size:24px; font-weight:800; }

  .lossrow{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:13px 0;
    border-bottom:1px solid var(--line);
  }
  .lossrow .k{ font-size:15px; font-weight:500; }
  .lossrow .v{ font-size:17px; font-weight:700; color:var(--red); white-space:nowrap; }

  .totalbox{
    background:#fdecec;
    border:1.5px solid #f3c9c9;
    border-radius:18px;
    padding:18px;
    margin:18px 0 10px;
  }
  .totalbox .k{
    font-size:12.5px;
    font-weight:700;
    letter-spacing:.03em;
    color:#8a2626;
    margin-bottom:6px;
  }
  .totalbox .v{
    font-size:32px;
    font-weight:800;
    color:var(--red);
  }

  .footnote{
    font-size:12px;
    color:var(--sub);
    line-height:1.6;
    margin-top:10px;
  }

  .yearcard{
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:18px;
    padding:16px 16px 4px;
    margin-bottom:18px;
  }
  .yearcard .yeartitle{
    font-size:18px;
    font-weight:800;
    margin-bottom:12px;
  }
  .yearcard .subhead{
    font-size:12px;
    font-weight:700;
    letter-spacing:.04em;
    color:var(--sub);
    margin:14px 0 8px;
    text-transform:uppercase;
  }
  .checkfield{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:14.5px;
    font-weight:500;
    margin-top:0;
    height:52px;
  }
  .checkfield input{ width:19px; height:19px; }

  .resultyear{
    border-top:2px solid var(--ink);
    padding-top:14px;
    margin-top:14px;
  }
  .resultyear .yh{ font-weight:800; font-size:17px; margin-bottom:10px; }

  .portada{ margin-bottom:28px; }
  .portada .bar{ border:none; border-top:6px solid var(--ink); margin:16px 0; }
  .portada .ptitle{
    font-size:22px;
    font-weight:800;
    line-height:1.25;
    text-align:center;
    margin:0 0 4px;
  }
  .pgtable{
    width:100%;
    border-collapse:collapse;
    border:1.5px solid var(--ink);
    font-size:13px;
    margin:10px 0;
  }
  .pgtable td{
    border:1px solid var(--line);
    padding:10px 12px;
    vertical-align:top;
    line-height:1.5;
  }
  .pgtable td.pglabel{
    font-weight:700;
    width:32%;
    text-align:center;
  }
  .pgtable ul{ margin:0; padding-left:18px; }
  .pgtable li{ margin-bottom:8px; }
  .pgtable li:last-child{ margin-bottom:0; }
  .quizhead{
    text-align:center;
    margin:18px 0 14px;
  }
  .quizhead .qtag{ font-size:15px; font-weight:600; color:var(--sub); }
  .quizhead .qtext{ font-size:19px; font-weight:800; margin-top:4px; }
  .quizopt{
    display:flex;
    gap:10px;
    padding:11px 0;
    border-bottom:1px solid var(--line);
    font-size:14.5px;
    line-height:1.4;
  }
  .quizopt b{ flex-shrink:0; }
  .quizopt.correct{
    background:#eaf5ee;
    border-radius:10px;
    padding:11px 10px;
    border-bottom:none;
  }
  .quizreveal{
    margin-top:16px;
    padding:14px 16px;
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:14px;
    font-size:14px;
    line-height:1.6;
  }
  .quizreveal strong{ color:var(--green); }

  .breaktable{
    width:100%;
    border-collapse:collapse;
    margin-bottom:16px;
    font-size:14px;
  }
  .breaktable th{
    text-align:right;
    font-size:11.5px;
    font-weight:700;
    letter-spacing:.02em;
    color:var(--sub);
    padding:0 0 8px;
    border-bottom:1.5px solid var(--line);
  }
  .breaktable th:first-child{ text-align:left; }
  .breaktable td{
    padding:9px 0;
    border-bottom:1px solid var(--line);
    text-align:right;
    font-family:'Inter',sans-serif;
  }
  .breaktable td:first-child{
    text-align:left;
    color:var(--sub);
    font-weight:500;
  }
  .breaktable td.correspond{ font-weight:600; }
  .breaktable td.real{ font-weight:700; color:var(--red); }
  .breaktable tr.totalrow td{
    border-bottom:none;
    border-top:2px solid var(--ink);
    padding-top:11px;
    font-weight:800;
    font-size:15.5px;
  }
  .breaktable tr.totalrow td.real{ color:var(--red); }
</style>
</head>
<body>
<div class="wrap">

<img src="data:image/jpeg;base64,















" alt="Lo que ganeis por un lado, lo perdereis por otro" style="display:block;width:120px;height:120px;margin:0 auto 10px;border-radius:16px;">
  <div style="font-style:italic; text-align:center; font-size:13px; color:var(--sub); margin-bottom:14px;">
    &#8226; En relaci&oacute;n con la PG-225 (retribuci&oacute;n variable), se negociar&aacute; un nuevo sistema de retribuci&oacute;n variable.<br>
    &#8226; Efecto abril en 2028<br>
    &#8226; Recuperaci&oacute;n del poder adquisitivo de un 7,95&nbsp;%<br>
    &#8226; Distribuido en 4 a&ntilde;os<br>
    &#8226; Pago &uacute;nico de 2000&euro;
  </div>
  <h1 style="text-align:center;">Calculadora de la letra peque&ntilde;a</h1>

  <div class="field">
    <label class="label" for="salario">Salario bruto fijo anual inicial (2025) (&euro;)</label>
    <input type="text" inputmode="decimal" id="salario" value="50000">
    <div class="hint">Introduce tu caso y supuestos</div>
  </div>

  <div id="anios4c"></div>

  <button type="button" class="calcbtn" id="calcBtnFull">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11.01"/><line x1="12" y1="11" x2="12" y2="11.01"/><line x1="16" y1="11" x2="16" y2="11.01"/><line x1="8" y1="15" x2="8" y2="15.01"/><line x1="12" y1="15" x2="12" y2="15.01"/><line x1="16" y1="15" x2="16" y2="15.01"/><line x1="8" y1="19" x2="8" y2="19.01"/><line x1="12" y1="19" x2="12" y2="19.01"/></svg>
    Calcular 2026&#8211;2029
  </button>

  <div class="results" id="resultsFull"></div>

  <hr class="sep">

  <h1 class="sub">&#191;Cu&aacute;nto se pierde por diferir la recuperaci&oacute;n salarial reconocida a 2026-2029?</h1>
  <div class="hint" style="margin-top:-10px;"><strong>La empresa se compromete a "recuperar nuestro poder adquisitivo perdido"</strong>, por tanto reconoce que nos debe ese incremento. &#191;Por qu&eacute; tenemos que aceptar seguir perdiendo durante 4 a&ntilde;os m&aacute;s?</div>
  <div class="hint">Compara recibir toda la recuperaci&oacute;n salarial ya, en 2026, frente a repartirla como la has puesto en cada a&ntilde;o de arriba. Usa el IPC, la subida individual, la promoci&oacute;n y el variable de cada a&ntilde;o (el variable se calcula sobre el salario del a&ntilde;o anterior). En esta comparaci&oacute;n se asume siempre efecto desde enero y consecuci&oacute;n de objetivos al 100&nbsp;% en ambos escenarios, para aislar solo el efecto de diferir la recuperaci&oacute;n.</div>

  <button type="button" class="calcbtn" id="calcBtnDiferir">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11.01"/><line x1="12" y1="11" x2="12" y2="11.01"/><line x1="16" y1="11" x2="16" y2="11.01"/><line x1="8" y1="15" x2="8" y2="15.01"/><line x1="12" y1="15" x2="12" y2="15.01"/><line x1="16" y1="15" x2="16" y2="15.01"/><line x1="8" y1="19" x2="8" y2="19.01"/><line x1="12" y1="19" x2="12" y2="19.01"/></svg>
    Calcular p&eacute;rdida por diferir
  </button>

  <div class="results" id="resultsDiferir">
    <div class="lineitem">
      <div class="k">Salario acumulado 2026-2029 &middot; recuperaci&oacute;n ya en 2026</div>
      <div class="v" id="acumInmediato">0 &euro;</div>
    </div>
    <div class="lineitem">
      <div class="k">Salario acumulado 2026-2029 &middot; recuperaci&oacute;n repartida</div>
      <div class="v" id="acumRepartido">0 &euro;</div>
    </div>
    <div class="totalbox">
      <div class="k">P&Eacute;RDIDA ACUMULADA 2026-2029 POR DIFERIR LA RECUPERACI&Oacute;N</div>
      <div class="v" id="perdida4y">&minus;0 &euro;</div>
    </div>
    <div class="footnote">Incluye fijo y variable. Efecto siempre desde enero y consecuci&oacute;n de objetivos al 100&nbsp;% en los dos escenarios.</div>
  </div>

  <hr class="sep">

  <h1 class="sub">P&eacute;rdida de salario acumulado (2020-2025) por desvincular la subida salarial al IPC</h1>
  <div class="hint" style="margin-top:-10px;">Compara la subida general (RSG) realmente aplicada cada a&ntilde;o con el IPC real desde 2020, y calcula cu&aacute;nto se ha perdido ya en euros sobre tu salario actual.</div>

  <table style="width:100%;border-collapse:collapse;margin:14px 0 18px;font-size:13.5px;">
    <thead>
      <tr style="border-bottom:1.5px solid var(--line);">
        <th style="text-align:left;padding:6px 4px;">A&ntilde;o</th>
        <th style="text-align:right;padding:6px 4px;">RSG Airbus</th>
        <th style="text-align:right;padding:6px 4px;">IPC real (dic.)</th>
      </tr>
    </thead>
    <tbody id="tablaHist"></tbody>
  </table>

  <button type="button" class="calcbtn" id="calcBtnPerdidaHist">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11.01"/><line x1="12" y1="11" x2="12" y2="11.01"/><line x1="16" y1="11" x2="16" y2="11.01"/><line x1="8" y1="15" x2="8" y2="15.01"/><line x1="12" y1="15" x2="12" y2="15.01"/><line x1="16" y1="15" x2="16" y2="15.01"/><line x1="8" y1="19" x2="8" y2="19.01"/><line x1="12" y1="19" x2="12" y2="19.01"/></svg>
    Calcular salario perdido
  </button>

  <div class="results" id="resultsPerdidaHist">
    <div class="totalbox">
      <div class="k">SALARIO PERDIDO ACUMULADO 2020&#8211;2025 (SOBRE TU SALARIO ACTUAL)</div>
      <div class="v" id="perdidaHist">&minus;0 &euro;</div>
    </div>
    <div class="footnote">Se reconstruye tu salario de partida (2019) dividiendo tu salario actual entre el efecto acumulado de las subidas RSG recibidas, y se compara la trayectoria real con la que habr&iacute;a seguido tu salario si cada a&ntilde;o hubiera subido con el IPC real. Usa el campo "Salario bruto fijo anual inicial" de arriba.</div>
  </div>

  <hr class="sep">

  <h1 class="sub">&#191;Cu&aacute;nto deber&iacute;amos recuperar realmente frente al 7,98&nbsp;% que nos reconocen?</h1>
  <div class="hint" style="margin-top:0;">El c&aacute;lculo de la p&eacute;rdida de poder adquisitivo es <strong>compuesto</strong>, no una simple resta entre IPC y RSG como propone la empresa.</div>
  <div class="hint" style="margin-top:-10px;">A partir de la misma tabla de arriba, esto es lo que har&iacute;a falta recuperar para no haber perdido poder adquisitivo desde 2020, frente a lo que realmente se reconoce.</div>

  <div class="field">
    <label class="label" for="reconocido">Recuperaci&oacute;n que nos reconoce la empresa (%)</label>
    <input type="text" inputmode="decimal" id="reconocido" value="7,98">
  </div>

  <button type="button" class="calcbtn" id="calcBtnHist">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11.01"/><line x1="12" y1="11" x2="12" y2="11.01"/><line x1="16" y1="11" x2="16" y2="11.01"/><line x1="8" y1="15" x2="8" y2="15.01"/><line x1="12" y1="15" x2="12" y2="15.01"/><line x1="16" y1="15" x2="16" y2="15.01"/><line x1="8" y1="19" x2="8" y2="19.01"/><line x1="12" y1="19" x2="12" y2="19.01"/></svg>
    Calcular diferencia
  </button>

  <div class="results" id="resultsHist">
    <div class="lineitem">
      <div class="k">Recuperaci&oacute;n real necesaria (2020&#8211;2025) para no haber perdido poder adquisitivo</div>
      <div class="v" id="recuperacionReal">0 %</div>
    </div>
    <div class="lineitem">
      <div class="k">Diferencia frente al 7,98&nbsp;% reconocido</div>
      <div class="v" id="diffReconocido">0 puntos</div>
    </div>
    <div class="hint"><strong>Ese poder adquisitivo no lo vas a recuperar nunca</strong>: la empresa solo reconoce parte de lo que hace falta para volver a donde estabas en 2020.</div>
    <div class="totalbox">
      <div class="k">P&Eacute;RDIDA ACUMULADA (2026&#8211;2029) POR EL PODER ADQUISITIVO NO RECONOCIDO</div>
      <div class="v" id="perdidaNoReconocido2029">&minus;0 &euro;</div>
    </div>
    <div class="hint">Y no acaba en 2029: al ser un porcentaje que nunca se incorpora a tu salario, <strong>seguir&aacute;s perdiendo esa misma diferencia cada a&ntilde;o hasta que te jubiles</strong>.</div>
    <div class="footnote">La proyecci&oacute;n 2026-2029 usa los datos que has introducido arriba (IPC, subida individual, promoci&oacute;n y recuperaci&oacute;n de cada a&ntilde;o) para calcular c&oacute;mo crece tu salario, y aplica sobre &eacute;l, cada a&ntilde;o, el porcentaje que sigue sin reconocerse.</div>
  </div>

  <hr class="sep">

  <h1 class="sub">Resumen: todas las p&eacute;rdidas para tu caso</h1>
  <div class="hint" style="margin-top:-10px;">Suma de las secciones anteriores, para el salario y los supuestos que has introducido.</div>
  <div id="resumenFinal"><div class="hint">Calcula las secciones anteriores para ver aqu&iacute; el resumen con el total.</div></div>

</div>

<script>
window.RESUMEN_PERDIDAS = { abrilVariable: null, diferir: null, hist2020: null, noReconocido2029: null };

function pintarResumen(){
  const r = window.RESUMEN_PERDIDAS;
  const filas = [
    { label: 'P\u00e9rdida por efecto abril y reducci\u00f3n de variable (2026\u20132029)', val: r.abrilVariable, consolidada: true },
    { label: 'P\u00e9rdida por diferir la recuperaci\u00f3n salarial reconocida (2026\u20132029)', val: r.diferir, consolidada: false },
    { label: 'Salario perdido acumulado por no seguir el IPC (2020\u20132025)', val: r.hist2020, consolidada: true },
    { label: 'P\u00e9rdida por poder adquisitivo no reconocido (2026\u20132029)', val: r.noReconocido2029, consolidada: true },
  ];
  const cont = document.getElementById('resumenFinal');
  if (!cont) return;

  const pendientes = filas.filter(f => f.val === null);
  if (pendientes.length === filas.length) {
    cont.innerHTML = '<div class="hint">Calcula las secciones anteriores para ver aqu\u00ed el resumen con el total.</div>';
    return;
  }

  let filasHtml = filas.map(f => {
    const valor = f.val === null ? '<span style="color:var(--sub);">Pendiente de calcular arriba</span>' : '\u2212' + fmtEUR(Math.abs(f.val));
    return '<tr><td>' + f.label + '</td><td class="real" style="text-align:right;">' + valor + '</td></tr>';
  }).join('');

  const total = filas.reduce((s, f) => s + (f.val || 0), 0);
  const todasListas = pendientes.length === 0;
  const PAGO_UNICO = 2000;
  const netoTrasPago = total - PAGO_UNICO;

  cont.innerHTML =
    '<table class="breaktable"><tbody>' + filasHtml + '</tbody></table>' +
    '<div class="totalbox">' +
      '<div class="k">P\u00c9RDIDA TOTAL' + (todasListas ? '' : ' (PARCIAL, FALTAN SECCIONES POR CALCULAR)') + '</div>' +
      '<div class="v">\u2212' + fmtEUR(Math.abs(total)) + '</div>' +
    '</div>' +
    '<table class="breaktable" style="margin-top:16px;"><tbody>' +
      '<tr><td>Pago \u00fanico ofrecido por la empresa en 2026 (no consolidable)</td><td class="correspond" style="text-align:right;">+' + fmtEUR(PAGO_UNICO) + '</td></tr>' +
      '<tr class="totalrow"><td>P\u00e9rdida neta descontando ese pago &uacute;nico</td><td class="real" style="text-align:right;">\u2212' + fmtEUR(Math.abs(netoTrasPago)) + '</td></tr>' +
    '</tbody></table>' +
    '<div class="hint" style="margin-top:14px;">El poder adquisitivo no reconocido, el efecto abril y la reducci\u00f3n del variable no desaparecen en 2029, seguir\u00e1n haci\u00e9ndote perder salario cada a\u00f1o hasta tu jubilaci\u00f3n.</div>';
}

function parseNum(str){
  if (typeof str !== 'string') return 0;
  let s = str.trim();
  if (s.includes(',') && s.includes('.')) {
    s = s.replace(/\./g, '').replace(',', '.');
  } else if (s.includes(',')) {
    s = s.replace(',', '.');
  }
  const v = parseFloat(s);
  return isNaN(v) ? 0 : v;
}
function val(id){ return parseNum(document.getElementById(id).value); }

function fmtEUR(n){
  const rounded = Math.round(n);
  return new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 }).format(rounded) + ' \u20ac';
}
function fmtPct(n, withSign){
  const rounded = Math.round(n * 10) / 10;
  const sign = withSign && rounded > 0 ? '+' : '';
  return sign + rounded.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
}

var ANIOS = [2026, 2027, 2028, 2029];
var RECUP_DEFECTO = { 2026: '2', 2027: '2', 2028: '2', 2029: '1,98' };
var IPC_DEFECTO = { 2026: '4,5', 2027: '3', 2028: '3', 2029: '3' };
var CONSEC_PILLS = [100, 95, 90, 85, 80, 70, 60, 50];

